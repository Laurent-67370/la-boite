# Modèle de /etc/la-boite/offsite.env — copier, remplir, puis : chmod 600 /etc/la-boite/offsite.env
# NE JAMAIS versionner le fichier rempli.
LA_BOITE_BACKUP_DIR=/var/backups/la-boite
# Clé PUBLIQUE age (sortie de « age-keygen -y cle.txt » sur TON poste) ; la clé privée ne vient jamais ici
OFFSITE_AGE_RECIPIENT=age1remplacer_par_la_cle_publique
# FTPS explicite (TLS imposé par le script) ; port 21 par défaut
OFFSITE_URL=ftp://ftp.exemple.fr
OFFSITE_USER=identifiant
LFTP_PASSWORD=mot_de_passe
OFFSITE_DIR=la-boite
OFFSITE_KEEP=7
